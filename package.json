{
  "name": "agent-app-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Frozen, additive-only app-ingress v1 contract — schemas, examples, and the conformance harness that certifies any agent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanerama/agent-app-contract.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test test/**/*.test.mjs",
    "gen": "npm run gen --workspace @agent-app/types",
    "validate:examples": "node scripts/validate-examples.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "22.20.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
